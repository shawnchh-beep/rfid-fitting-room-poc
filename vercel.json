{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "crons": [
    {
      "path": "/api/demo-data/daily-seed",
      "schedule": "10 16 * * *"
    }
  ],
  "rewrites": [
    {
      "source": "/product.html",
      "destination": "/public/index.html"
    },
    {
      "source": "/product",
      "destination": "/public/index.html"
    },
    {
      "source": "/csv-import.html",
      "destination": "/public/index.html"
    },
    {
      "source": "/csv-import",
      "destination": "/public/index.html"
    },
    {
      "source": "/setting.html",
      "destination": "/public/index.html"
    },
    {
      "source": "/setting",
      "destination": "/public/index.html"
    },
    {
      "source": "/dashboard",
      "destination": "/public/index.html"
    },
    {
      "source": "/fitting-demo",
      "destination": "/public/index.html"
    },
    {
      "source": "/fortuneteller",
      "destination": "/public/fortuneteller/index.html"
    },
    {
      "source": "/fortuneteller/admin",
      "destination": "/public/fortuneteller/admin/index.html"
    },
    {
      "source": "/fortuneteller/:path*",
      "destination": "/public/fortuneteller/:path*"
    },
    {
      "source": "/",
      "destination": "/public/index.html"
    },
    {
      "source": "/css/:path*",
      "destination": "/public/css/:path*"
    },
    {
      "source": "/js/:path*",
      "destination": "/public/js/:path*"
    }
  ]
}
